      "id": "a0dcf4de-67f7-4c39-86e5-b4c3cd3209ed",
      "name": "Loop Over Domains",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -384,
        160
      ]
    },
    {
      "parameters": {
        "url": "={{$json.url}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 10000
        }
      },
      "id": "2af7dac2-6928-45a6-b72c-4e7590d13c45",
      "name": "Загрузить HTML страницы",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        -32
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const html = ($input.item.json.data || '').toString();\nconst lowerHtml = html.toLowerCase();\nlet cms = 'unknown';\nif (html.includes('wp-content') || html.includes('/wp-json/') || html.includes('wp-includes')) cms = 'WordPress';\nelse if (lowerHtml.includes('ghost') && lowerHtml.includes('content=\"ghost')) cms = 'Ghost';\nelse if (lowerHtml.includes('blogger') || lowerHtml.includes('blogspot')) cms = 'Blogger';\nelse if (html.includes('Joomla!') || html.includes('/components/com_')) cms = 'Joomla';\nelse if (html.includes('sites/default/files') || html.includes('Drupal.settings')) cms = 'Drupal';\nelse if (lowerHtml.includes('bitrix')) cms = 'Bitrix';\nelse if (html.includes('/typo3conf/')) cms = 'TYPO3';\nelse if (lowerHtml.includes('modx')) cms = 'MODX';\nelse if (lowerHtml.includes('tilda')) cms = 'Tilda';\nconst forumSignatures = ['phpbb', 'vbulletin', 'discourse', 'invision power board', 'ipboard', 'simplemachines', 'smf', 'xenforo', 'vanilla forums', 'forum rules', 'thread starter', 'new topic', 'post reply', 'viewforum', 'viewtopic'];\nconst isForum = forumSignatures.some(sig => lowerHtml.includes(sig)) || /\\/forum(s)?\\//.test(lowerHtml) || /\\bforum\\b/.test(lowerHtml.match(/<title[^>]*>(.*?)<\\/title>/i)?.[1]?.toLowerCase() || '');\nconst isBlog = /\\/blog\\//.test(lowerHtml) || lowerHtml.includes('rel=\"category tag\"') || lowerHtml.includes('posted in') || lowerHtml.includes('published on') || lowerHtml.includes('article:published_time') || cms === 'WordPress' || cms === 'Ghost' || cms === 'Blogger';\nconst hasCommentForm = (/<form[^>]*id=[\"']?comment/i.test(html) || /<form[^>]*class=[\"'][^\"']*comment/i.test(html) || lowerHtml.includes('leave a reply') || lowerHtml.includes('leave a comment') || lowerHtml.includes('post a comment') || lowerHtml.includes('оставить комментарий') || lowerHtml.includes('добавить комментарий'));\nconst requiresRegistration = /(you must be logged in to post a comment|login to comment|войдите чтобы оставить комментарий)/i.test(html);\nconst site = $('Loop Over Domains').item.json;\nreturn { json: { url: site.url, title: site.title, niche: site.niche, cms, isForum, isBlog, hasCommentForm, requiresRegistration } };",
        "mode": "runOnceForEachItem"
      },
